{
  "buildCommand": "node .v0/inject-built-with-v0.mjs && echo 'Static site ready'",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/health/:check",
      "destination": "/api/health"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
